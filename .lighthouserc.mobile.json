    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4173",
      "startServerReadyPattern": "127.0.0.1:4173",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/reparacao-manutencao-relogios",
        "http://127.0.0.1:4173/casamentos",
        "http://127.0.0.1:4173/contactos"
      ]
    },
    "assert": {
