{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/relay/insights/script.js", "dest": "/_vercel/insights/script.js" },
    { "src": "/relay/insights/view", "dest": "/_vercel/insights/view" },
    { "src": "/relay/insights/event", "dest": "/_vercel/insights/event" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
